# Environment Variables Template
# Copy this file to .env and fill in your values
# For production deployments, set these in your hosting platform's environment variable settings

# ==================== SERVER ====================
# Set NODE_ENV=production on Render/Railway
NODE_ENV=development
PORT=5000

# ==================== FRONTEND ====================
# Set on Vercel: VITE_API_URL and VITE_BASE_PATH
# Local: VITE_API_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
VITE_BASE_PATH=/

# Set on Render/Railway: CLIENT_ORIGIN must be your production domain
# Examples:
#   localhost: CLIENT_ORIGIN=http://localhost:5173
#   Vercel:   CLIENT_ORIGIN=https://your-project.vercel.app
#   Render:   CLIENT_ORIGIN=https://your-app.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# ==================== DATABASE ====================
# Get free URI: https://www.mongodb.com/cloud/atlas
# Replace <username>, <password>, <cluster> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/vypax

# ==================== EMAIL (Gmail App Password) ====================
# STEP 1: Enable 2-Step Verification on your Google Account
#   - Go to https://myaccount.google.com/security
#   - Click "2-Step Verification" → Turn ON
#
# STEP 2: Generate App Password
#   - Go to https://myaccount.google.com/apppasswords
#   - Select app: Mail
#   - Select device: Other (name it "Vypax Server")
#   - Click Generate
#   - Copy the 16-character password (no spaces)
#
# STEP 3: Paste it below (no spaces, no quotes)
EMAIL_SERVICE=gmail
EMAIL_USER=vypaxtechnologies@gmail.com
EMAIL_PASS=your-16-letter-app-password-here
NOTIFICATION_EMAIL=vypaxtechnologies@gmail.com
