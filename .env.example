# Environment Variables Template
# Copy this file to .env and fill in your values
# For production deployments, set these in your hosting platform's environment variable settings

# Server port
PORT=5000

# Frontend origin - set to your production domain in production
# Examples:
#   localhost: CLIENT_ORIGIN=http://localhost:5173
#   Vercel:   CLIENT_ORIGIN=https://your-project.vercel.app
#   Netlify:  CLIENT_ORIGIN=https://your-site.netlify.app
#   Render:   CLIENT_ORIGIN=https://your-app.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string
# Free tier: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb://127.0.0.1:27017/vypax

# Email Configuration (Gmail App Password)
# 1. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate a 16-letter app password for "Mail"
# 3. Paste the 16 letters (no spaces) below
EMAIL_SERVICE=gmail
EMAIL_USER=vypaxtechnologies@gmail.com
EMAIL_PASS=your-16-letter-app-password-here
NOTIFICATION_EMAIL=vypaxtechnologies@gmail.com
